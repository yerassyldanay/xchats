# xchats — secrets & environment wiring (copy to .env; NEVER commit .env).
# Behaviour/limits/seed live in config.yaml; secrets live here.

# --- Evolution (reused WhatsApp gateway) ---
EVOLUTION_BASE_URL=http://localhost:9700
EVOLUTION_API_KEY=                 # from chat — verify it's complete (~35 chars)
EVOLUTION_INSTANCE=xpayment        # the instance NAME (confirm via GET /instance/fetchInstances)

# --- our webhook (Evolution -> backend) ---
WEBHOOK_TOKEN=change-me-shared-token            # Evolution echoes this header; we verify it
WEBHOOK_PUBLIC_BASE_URL=http://localhost:8080   # URL Evolution uses to reach our webhook

# --- Postgres (shared with Evolution; we use the xchats schema) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xchats?sslmode=disable

# --- auth / sessions ---
SESSION_SECRET=change-me-random
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# --- the single pre-connected account's own JID (envelope top-level `sender`) ---
# e.g. 77011111111@s.whatsapp.net. If unset, learned once via FetchInstances at boot.
WA_OWNER_JID=

# --- AI brain (LLM) ---
# If LLM_API_KEY is empty, the assistant falls back to a hardcoded stub (the app
# still runs). Set it to enable the real KB-grounded suggestions. Provider is
# OpenAI-compatible (openrouter|openai|gemini); base URL is derived from it unless
# LLM_BASE_URL overrides (point this at a self-hosted/in-region model if needed).
LLM_API_KEY=
LLM_PROVIDER=openrouter
# LLM_BASE_URL=                       # overrides the provider default base URL
# LLM_FAST_MODEL=openai/gpt-4o-mini   # drafting model
# LLM_VISION_MODEL=openai/gpt-4o      # multimodal model for Playground KB media extraction
#                                     # (empty => images fall back to describe popups)
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.3

# --- server ---
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173
