feedback

# secrets / local config. The root config.yaml is committed on purpose (see
# its own header comment) — it carries no secrets, only boot/infra tunables.
# .env.* (not just a bare .env) so a real .env.local/.env.production is
# never accidentally trackable either; the two .example files are the
# templates and must stay committed.
.env
.env.*
!.env.example
!*/.env.example
backend/.env
backend/config.yaml
frontend/.env

cookies.txt

# The repo ships exactly ONE compose file (deploy/docker-compose.yaml). This
# entry exists so that a machine-specific escape hatch can never be committed
# again: docker compose still auto-loads deploy/docker-compose.override.yaml
# if you create one locally, but it stays yours. Prefer exporting
# BACKEND_PORT/FRONTEND_PORT for a port clash — that needs no file at all.
deploy/docker-compose.override.yaml

# blob store (local-disk media bytes)
blobdata/
backend/blobdata/

# SQLite data directory (xchats.db + whatsmeow.db and their WAL/lock
# sidecars) — config.yaml's committed storage.db_path/wa_device_db_path
# defaults both live under ./data.
data/
*.db
*.db-wal
*.db-shm
*.db.lock

# build output
# One entry per backend/cmd/* package: `go build ./...` run from backend/
# writes a binary named after each main package into the working directory,
# which is how backend/promptpreview once got committed (PR #15).
backend/bin/
backend/xchats
backend/promptpreview
backend/ngrok-credential-probe
backend/ngrok-v2-probe
frontend/dist/
frontend/dist-ssr/
frontend/node_modules/
node_modules/

# playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/test-screens/

# go
*.test
coverage.out
*.prof

# `go mod vendor` output — only ever populated by the release workflow's
# source-bundle job, in its own ephemeral checkout (see release.yml). A
# leftover local copy must never get committed, and must never sit around
# silently flipping local `go` commands to -mod=vendor (scripts/notices.sh
# depends on that not happening).
backend/vendor/

# credentials / keys — never legitimately committed anywhere in this repo
*.pem
*.key
*.p12
*.pfx
id_rsa*

# editor / os
.DS_Store
*.swp
.idea/
.vscode/

.claude
.cache