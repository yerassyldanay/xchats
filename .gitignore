feedback

# secrets / local config. The root config.yaml is committed on purpose (see
# its own header comment) — it carries no secrets, only boot/infra tunables.
.env
backend/.env
backend/config.yaml
frontend/.env

cookies.txt

# local-only deploy helpers (machine-specific host ports) — keep out of git
deploy/docker-compose.override.yaml

# blob store (local-disk media bytes)
blobdata/
backend/blobdata/

# SQLite data directory (xchats.db + whatsmeow.db and their WAL/lock
# sidecars) — config.yaml's committed storage.db_path/wa_device_db_path
# defaults both live under ./data.
data/
*.db
*.db-wal
*.db-shm
*.db.lock

# build output
# One entry per backend/cmd/* package: `go build ./...` run from backend/
# writes a binary named after each main package into the working directory,
# which is how backend/promptpreview once got committed (PR #15).
backend/bin/
backend/xchats
backend/promptpreview
frontend/dist/
frontend/dist-ssr/
frontend/node_modules/
node_modules/

# playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# go
*.test

# editor / os
.DS_Store
*.swp

.claude
.cache