<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Разрешение доступа — Xchats</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f6f7f9; color: #1a1d21;
         display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
  @media (prefers-color-scheme: dark) { body { background: #16181c; color: #e7e9ec; } }
  .card { background: white; border-radius: 12px; padding: 32px; width: 380px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  @media (prefers-color-scheme: dark) { .card { background: #22252a; box-shadow: none; border: 1px solid #33373d; } }
  h1 { font-size: 18px; margin: 0 0 4px; }
  p.sub { font-size: 13px; color: #6b7280; margin: 0 0 20px; }
  .user { font-size: 13px; color: #6b7280; margin-bottom: 16px; }
  label { display: block; font-size: 13px; margin: 12px 0 4px; }
  select { width: 100%; box-sizing: border-box; padding: 8px 10px; border-radius: 8px; border: 1px solid #d1d5db; font-size: 14px; }
  @media (prefers-color-scheme: dark) { select { background: #1a1d21; border-color: #3a3f47; color: inherit; } }
  ul.scopes { list-style: none; padding: 0; margin: 12px 0 0; }
  ul.scopes li { font-size: 13px; padding: 6px 0; display: flex; gap: 8px; align-items: flex-start; }
  ul.scopes li::before { content: "✓"; color: #16a34a; font-weight: 700; }
  .actions { display: flex; gap: 10px; margin-top: 22px; }
  button { flex: 1; padding: 10px; border-radius: 8px; border: none; font-size: 14px; font-weight: 600; cursor: pointer; }
  .approve { background: #2563eb; color: white; }
  .deny { background: transparent; color: #6b7280; border: 1px solid #d1d5db; }
  @media (prefers-color-scheme: dark) { .deny { border-color: #3a3f47; } }
</style>
</head>
<body>
  <div class="card">
    <h1>«{{.ClientName}}» запрашивает доступ</h1>
    <p class="sub">к базе знаний Xchats</p>
    <div class="user">Вы вошли как {{.UserEmail}}</div>
    <form method="POST" action="{{.APIBaseURL}}/oauth/authorize/decision">
      {{range $k, $v := .HiddenFields}}<input type="hidden" name="{{$k}}" value="{{$v}}">
      {{end}}
      {{if gt (len .Organizations) 1}}
      <label for="organization_id">Организация</label>
      <select name="organization_id" id="organization_id">
        {{range .Organizations}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
      </select>
      {{else}}
      <input type="hidden" name="organization_id" value="{{(index .Organizations 0).ID}}">
      {{end}}
      <ul class="scopes">
        {{range .ScopeDescriptions}}<li>{{.}}</li>{{end}}
      </ul>
      <div class="actions">
        <button type="submit" name="decision" value="deny" class="deny">Отмена</button>
        <button type="submit" name="decision" value="approve" class="approve">Разрешить</button>
      </div>
    </form>
  </div>
</body>
</html>
