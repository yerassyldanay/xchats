# evals/.env.example — copy to evals/.env and fill in; NEVER commit evals/.env.
# (The repo's root .gitignore already ignores any file named ".env", including this one.)
#
# Used by `harness extract` (Eval 1: file -> extracted information) for direct OpenRouter
# calls. The existing `harness run` (Layer-1 prompt evals, via promptfoo) reads
# OPENROUTER_API_KEY the same way — one key, both tools.

# Required. Same value as LLM_API_KEY in the repo's root .env.
OPENROUTER_API_KEY=

# Optional overrides — sensible defaults are used if left unset.

# Comma-separated OpenRouter model ids to run when -models isn't passed on the command
# line. Defaults to every provider listed in evals/models.yaml.
# EVAL_VISION_MODELS=google/gemini-2.5-flash,google/gemini-2.5-flash-lite,openai/gpt-4o-mini

# Override the OpenRouter API base URL (e.g. to point at a proxy). Defaults to the real
# OpenRouter endpoint.
# EVAL_BASE_URL=https://openrouter.ai/api/v1
