# evals/.env.example — copy to evals/.env and fill in; NEVER commit evals/.env.
# (The repo's root .gitignore already ignores any file named ".env", including this one.)
#
# Used by `harness run` for OpenRouter-backed response evaluations.

# Required. Same value as LLM_API_KEY in the repo's root .env.
OPENROUTER_API_KEY=

# Optional overrides — sensible defaults are used if left unset.

# Override the OpenRouter API base URL (e.g. to point at a proxy). Defaults to the real
# OpenRouter endpoint.
# EVAL_BASE_URL=https://openrouter.ai/api/v1
