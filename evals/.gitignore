# Generated by the harness — always reproducible from scenario.yaml/data.yaml/tests.yaml.
scenarios/*/generated/

# Runs are local by default. Selected files from a durable evidence bundle are
# force-added deliberately; ordinary experiments must not grow the repository.
# Existing curated bundles remain tracked even though they match this rule.
runs/*/
!runs/launches/
!runs/launches/*.json
runs/*.json
runs/*.html

# Legacy promptfoo exports are not a second source of truth.
results/*
!results/.gitkeep

# Full video files are not normal eval fixtures. Add a small one deliberately with
# `git add -f` only when an active video case requires it.
assets/*.mov
assets/*.MOV
assets/*.mp4
assets/*.MP4

# The eval comparison UI's derived JSON exports (evals/harness/export.go) — same
# regenerable status as runs/*/*.html and runs/index.html just above: reproducible
# from the committed *.judged.json/manifest.json via `harness export -all`, never a
# second source of truth. runs/launches/*.json is DIFFERENT and deliberately NOT
# listed here — see the comment there.
runs/*/executions.json
runs/runs.json

# The requirements-catalog export (evals/harness/catalog.go) — same regenerable status:
# reproducible from committed scenario.yaml/data.yaml/tests.yaml/extract/cases.yaml via
# `harness export -all`, including its copied/preprocessed case images.
runs/catalog.json
runs/catalog/

# Hand-authored SAMPLE/DEMO fixtures (not real model output) used to preview the eval
# comparison UI without spending anything — must never be mistaken for real results,
# so they're excluded from the runs/ commit policy above outright, not just their
# derived files. See evals/harness/runs/README (if present) or any run whose manifest
# command field says "SAMPLE FIXTURE".
runs/demo-*/

harness/harness
harness/xchats-evals-harness
