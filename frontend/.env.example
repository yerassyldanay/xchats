# Frontend env (copy to frontend/.env). Empty = same-origin (dev uses the Vite
# proxy to the backend; prod fronts both behind one domain). Set to the backend
# origin for a split deployment, e.g. https://api.xchats.example
VITE_API_BASE_URL=

# Official Meta channels (WhatsApp Cloud API, Instagram Direct, Messenger) are
# hidden in the UI by default ("Coming soon"). Set to true to bring them back;
# the backend support is always compiled in.
VITE_ENABLE_META_CHANNELS=
