{
  "name": "xchats-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && tsx scripts/build-blog.ts",
    "new-blog-post": "tsx scripts/new-blog-post.ts",
    "preview": "vite preview --port 5173",
    "preview:blog": "vite preview --config vite.preview-blog.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:blog": "playwright test --config=playwright.blog.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.3.0",
    "nanoid": "^5.1.5",
    "pinia": "^2.2.6",
    "reka-ui": "^2.9.10",
    "tailwind-merge": "^2.6.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4.4.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "^3.5.13",
    "autoprefixer": "^10.4.20",
    "image-size": "^2.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
