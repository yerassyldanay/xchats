{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    // No "baseUrl": deprecated in TypeScript 6, removed in 7. It was redundant
    // anyway — these paths are already tsconfig-relative ("./src/*"), which is
    // exactly how `paths` resolves on its own once baseUrl is absent.
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "env.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
